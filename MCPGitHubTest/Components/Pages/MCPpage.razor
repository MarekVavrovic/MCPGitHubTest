@page "/MCPpage"

@using Microsoft.Extensions.AI
@using ModelContextProtocol.Client
@using OpenAI
@using OpenAI.Chat
@using Microsoft.Agents.AI

//UI improvement libraries
@using Markdig
@using Ganss.Xss

@implements IAsyncDisposable
@inject IConfiguration Configuration

@rendermode InteractiveServer

<div class="border rounded p-4 mb-4" style="background-color: #f8f9fa; border-width: 2px;">
    <h2 class="mb-2">Tool Calling using an MCP Server</h2>
    <p>
        <strong>This page demonstrates how to connect to and utilize a Model Context Protocol (MCP) server, specifically GitHub's Copilot MCP endpoint.</strong>
        <br />
        By entering your question below, you can interact with the GitHub MCP server using an AI agent that leverages available <b>Tools</b> and Models. The integration showcases secure authentication, tool discovery, and conversational AI capabilities, enabling advanced interactions with GitHub's AI-powered services.
    </p>
    <p>We needed to use a Blazor Web App with Render Mode Interactive Server to facilitate the interaction with the MCP server.</p>
    <p>
        It enables AI applications to access real-time, real-world information and perform tasks, similar to how a web browser uses
        HTTP to connect to websites. MCP standardizes this connection, allowing AI agents to be more context-aware, perform actions,
        and overcome the limitations of their training data.
    </p>

    <div class="alert alert-secondary mt-4">
        <h5 class="mb-2">Example Prompt</h5>
        <blockquote class="mb-2" style="font-size: 1.05em;">
            “Generate a C# function that takes a list of integers and returns only the even numbers.
            Also, summarize in one paragraph how this function works and provide a unit test for it.”
        </blockquote>
        <ul class="mb-0">
            <li>Code generation</li>
            <li>Explanation/summarization</li>
            <li>Test creation</li>
        </ul>
        <small class="text-muted">
            This prompt demonstrates how you can request code, explanations, and tests all in 
            a single request, leveraging the advanced tools and models available via the MCP server.
        </small>
    </div>
</div>

<h3>Referencing an MCP Server</h3>

<div class="mb-3">
    <label for="userInput" class="form-label">Enter your question</label>

    <input @bind="userPrompt"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown"
           id="userInput"
           class="form-control"
           placeholder="Ask me anything..."
           disabled="@isBusy" />

    <button @onclick="SubmitPrompt"
            class="btn btn-primary mt-3"
            disabled="@isBusy || string.IsNullOrWhiteSpace(userPrompt)">
        @(isBusy ? "Generating..." : "Send to ChatGPT")
    </button>

    <button @onclick="ClearAll"
            class="btn btn-secondary mt-3"
            disabled="@isBusy">
        Clear All
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (chatHistory.Count > 0)
{
    <div class="alert alert-info">

        @foreach (var entry in chatHistory)
        {
            <div class="mb-3">

                <strong>@entry.Role:</strong>

                <div class="mt-2 markdown-content">
                    @((MarkupString)RenderMarkdown(entry.Text))
                </div>

            </div>
        }

    </div>
}

@code {

    // User interface
    private string userPrompt = string.Empty;
    private bool isBusy;
    private string? errorMessage;

    // Conversation history
    private List<(string Role, string Text)> chatHistory = new();

    // OpenAI configuration
    private const string model = "gpt-4o-mini";

    // Agent Framework objects
    private AIAgent? agent;
    private AgentSession? session;  
   
    private McpClient? gitHubMcpClient;

    private async Task InitializeAgent()
    {
        if (agent != null)
            return;

        // Read credentials from server-side configuration
        string apiKey = Configuration["OpenAI:ApiKey"] ?? throw new InvalidOperationException("OpenAI API key is missing.");
        string githubToken = Configuration["GitHub:McpToken"]?? throw new InvalidOperationException("GitHub MCP token is missing.");

        // Connect to GitHub MCP server
        var transport = new HttpClientTransport(
            new HttpClientTransportOptions
            {
                Endpoint = new Uri("https://api.githubcopilot.com/mcp/"),
                TransportMode = HttpTransportMode.StreamableHttp,
                AdditionalHeaders = new Dictionary<string, string>
                {
                    ["Authorization"] = $"Bearer {githubToken}"
                }
            });

        gitHubMcpClient = await McpClient.CreateAsync(transport);

        try
        {
            // Discover GitHub MCP tools
            var toolsInGitHubMcp =await gitHubMcpClient.ListToolsAsync();

            // Create OpenAI client
            var client = new OpenAIClient(apiKey);

            // Create AI agent and register GitHub MCP tools
            agent = client.GetChatClient(model)
                .AsAIAgent(
                           instructions: """
                    You are a professional C# programming assistant.
                    Always format your responses using Markdown.
                    Use:
                    - Headings for sections.
                    - Fenced C# code blocks for code examples.
                    - Bullet points for explanations.
                    - Tables when comparing technologies.
                    - Clear explanations suitable for developers.

                    Keep code examples properly formatted and readable.
                    """,
                    tools: toolsInGitHubMcp.Cast<AITool>().ToList()
                )
                .AsBuilder()
                .Build();
        }
        catch
        {
            await gitHubMcpClient.DisposeAsync();
            gitHubMcpClient = null;
            throw;
        }
    }

    // Send user prompt
    private async Task SubmitPrompt()
    {
        if (isBusy || string.IsNullOrWhiteSpace(userPrompt))
            return;

        isBusy = true;
        errorMessage = null;

        string currentPrompt = userPrompt.Trim();
        userPrompt = string.Empty;

        chatHistory.Add(("User", currentPrompt));

        int assistantIndex = chatHistory.Count;
        chatHistory.Add(("Assistant", string.Empty));

        try
        {            
            await InitializeAgent();

            // Create conversation session
            session ??= await agent!.CreateSessionAsync();
            string responseText = string.Empty;

            // Stream response from AI agent
            await foreach (AgentResponseUpdate update in
                agent!.RunStreamingAsync(currentPrompt, session))
            {
                if (!string.IsNullOrEmpty(update.Text))
                {
                    responseText += update.Text;
                    chatHistory[assistantIndex] = ("Assistant", responseText);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Something went wrong: {ex.Message}";

            chatHistory[assistantIndex] =
                ("Assistant", "Sorry, an error occurred.");
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Send prompt using Enter
    private async Task HandleKeyDown( Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isBusy)
        {
            await SubmitPrompt();
        }
    }

    // Clear conversation
    private void ClearAll()
    {
        if (isBusy)
            return;

        userPrompt = string.Empty;
        chatHistory.Clear();
        errorMessage = null;
        session = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (gitHubMcpClient != null)
        {
            await gitHubMcpClient.DisposeAsync();
            gitHubMcpClient = null;
        }
    }

    //Markdown rendering method
    private static readonly MarkdownPipeline markdownPipeline =
                            new MarkdownPipelineBuilder()
                                .UseAdvancedExtensions()
                                .Build();

    private static readonly HtmlSanitizer htmlSanitizer = new HtmlSanitizer();

    private string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        // Convert Markdown into HTML
        string html = Markdown.ToHtml(markdown, markdownPipeline);

        // Sanitize generated HTML
        return htmlSanitizer.Sanitize(html);
    }
}
